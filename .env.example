# 可选：只有主动选择 OpenAI 多模态 provider 时才需要。
OPENAI_API_KEY=
# 必须显式填写你账户可用且支持图像输入的模型 ID；工程不擅自假定模型可用性。
OPENAI_VISION_MODEL=

# 可选：Dots Studio 多模态视觉 provider。不要把真实 Key 提交到版本库。
DOTS_API_KEY=
DOTS_BASE_URL=https://note3-prev-api.askdiandian.com
DOTS_VISION_MODEL=dots3-note-prev
# 可选：文化助手在本地证据不足时使用的文本模型；留空时复用 DOTS_VISION_MODEL。
DOTS_TEXT_MODEL=dots3-note-prev
